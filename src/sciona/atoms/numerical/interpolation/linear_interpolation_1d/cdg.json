    {
      "name": "validate_and_sort_interpolation_grid",
      "semantic_role": "Verify and sort input grid coordinates to ensure strict monotonicity.",
      "source_targets": [
        "numpy.sort",
        "numpy.diff"
      ],
      "inputs": [
        {
          "name": "x_grid",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "y_values",
          "type_desc": "NDArray[np.float64]",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "sorted_x",
          "type_desc": "NDArray[np.float64]"
        },
        {
          "name": "sorted_y",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "x_grid.ndim == 1",
        "len(x_grid) >= 2",
        "len(x_grid) == len(y_values)"
      ],
      "postcondition_candidates": [
        "np.all(np.diff(sorted_x) > 0)"
      ],
      "witness_shape_semantics": "Returns coordinate arrays of length N.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "search_interval_indices",
      "semantic_role": "Identify grid intervals containing evaluation points using binary search.",
      "source_targets": [
        "numpy.searchsorted"
      ],
      "inputs": [
        {
          "name": "grid",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "points",
          "type_desc": "NDArray[np.float64]",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "indices",
          "type_desc": "NDArray[np.int64]"
        }
      ],
      "precondition_candidates": [
        "np.all(np.diff(grid) > 0)"
      ],
      "postcondition_candidates": [
        "np.all(indices >= 0)",
        "np.all(indices < len(grid))"
      ],
      "witness_shape_semantics": "Returns index array of length matching evaluation points M.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "compute_linear_blend",
