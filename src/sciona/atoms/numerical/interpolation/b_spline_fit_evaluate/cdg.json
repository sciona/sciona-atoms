{
  "cdg_id": "b_spline_fit_evaluate",
  "name": "b_spline_fit_evaluate",
  "priority": "medium",
  "decomposition_rationale": "Separate B-spline representation creation (knot generation and coefficient fitting) from recursive basis evaluation so fit objects can be stored and evaluated, integrated, or differentiated repeatedly.",
  "family_directory_hint": "src/sciona/atoms/numerical/interpolation/",
  "atomic_nodes": [
    {
      "name": "generate_knot_vector",
      "semantic_role": "Generate clamped or uniform knot vector for B-splines.",
      "source_targets": [
        "scipy.interpolate.make_interp_spline"
      ],
      "inputs": [
        {
          "name": "x",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "k",
          "type_desc": "int",
          "required": true,
          "constraints": "k >= 0"
        }
      ],
      "outputs": [
        {
          "name": "knots",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "len(x) >= k + 1",
        "np.all(np.diff(x) > 0)"
      ],
      "postcondition_candidates": [
        "len(knots) == len(x) + k + 1"
      ],
      "witness_shape_semantics": "Creates non-decreasing knot sequence with clamped boundary multiplicities.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "solve_bspline_coefficients",
      "semantic_role": "Solve the linear interpolation/least-squares system for B-spline coefficients.",
      "source_targets": [
        "scipy.interpolate.make_interp_spline",
        "scipy.linalg.solve_banded"
      ],
      "inputs": [
        {
          "name": "x",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "y",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "knots",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "k",
          "type_desc": "int",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "coefficients",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "len(knots) == len(x) + k + 1"
      ],
      "postcondition_candidates": [
        "len(coefficients) == len(x)"
      ],
      "witness_shape_semantics": "Returns B-spline coefficients matching the input grid length.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "evaluate_bspline_cox_de_boor",
      "semantic_role": "Evaluate B-spline curve at specified evaluation coordinates using recursive Cox-de Boor algorithm.",
      "source_targets": [
        "scipy.interpolate.BSpline"
      ],
      "inputs": [
        {
          "name": "knots",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "coefficients",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "k",
          "type_desc": "int",
          "required": true
        },
        {
          "name": "x_eval",
          "type_desc": "NDArray[np.float64]",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "result",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "len(knots) == len(coefficients) + k + 1"
      ],
      "postcondition_candidates": [
        "len(result) == len(x_eval)"
      ],
      "witness_shape_semantics": "Computes local spline blends. Output matches evaluation coordinate shape.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    }
  ],
  "edges": [
    {
      "source": "generate_knot_vector",
      "target": "solve_bspline_coefficients",
      "output_name": "knots",
      "input_name": "knots"
    },
    {
      "source": "generate_knot_vector",
      "target": "evaluate_bspline_cox_de_boor",
      "output_name": "knots",
      "input_name": "knots"
    },
    {
      "source": "solve_bspline_coefficients",
      "target": "evaluate_bspline_cox_de_boor",
      "output_name": "coefficients",
      "input_name": "coefficients"
    }
  ],
  "cdg_io": {
    "inputs": [
      {
        "name": "x",
        "type_desc": "NDArray[np.float64]",
        "required": true
      },
      {
        "name": "y",
        "type_desc": "NDArray[np.float64]",
        "required": true
      },
      {
        "name": "k",
        "type_desc": "int",
        "required": true
      },
      {
        "name": "x_eval",
        "type_desc": "NDArray[np.float64]",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "result",
        "type_desc": "NDArray[np.float64]"
      }
    ]
  },
  "state_model_needed": false
}