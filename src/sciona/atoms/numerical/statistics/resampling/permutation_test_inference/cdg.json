{
  "cdg_id": "permutation_test_inference",
  "name": "permutation_test_inference",
  "priority": "medium",
  "decomposition_rationale": "Separates the calculation of the observed statistic, label pooling/shuffling, and empirical $p$-value estimation. Allows utilizing different test statistics on the same shuffled indices.",
  "family_directory_hint": "src/sciona/atoms/numerical/statistics/resampling/",
  "edges": [
    {
      "source": "compute_observed_statistic",
      "target": "calculate_permutation_p_value",
      "output_name": "observed_stat",
      "input_name": "observed_stat"
    },
    {
      "source": "generate_permutation_null",
      "target": "calculate_permutation_p_value",
      "output_name": "null_distribution",
      "input_name": "null_distribution"
    }
  ],
  "cdg_io": {
    "inputs": [
      {
        "name": "x",
        "type_desc": "NDArray[np.float64]",
        "required": true
      },
      {
        "name": "y",
        "type_desc": "NDArray[np.float64]",
        "required": true
      },
      {
        "name": "metric",
        "type_desc": "str",
        "required": true
      },
      {
        "name": "n_permutations",
        "type_desc": "int",
        "required": true
      }
    ],
    "outputs": [
      {
        "name": "p_value",
        "type_desc": "float"
      },
      {
        "name": "observed_stat",
        "type_desc": "float"
      }
    ]
  },
  "state_model_needed": false,
  "nodes": [
    {
      "name": "compute_observed_statistic",
      "semantic_role": "Evaluate the raw metric (difference in mean, median, etc.) on the unshuffled samples.",
      "source_targets": [
        "numpy.mean",
        "numpy.median"
      ],
      "inputs": [
        {
          "name": "x",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "y",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "metric",
          "type_desc": "str",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "observed_stat",
          "type_desc": "float"
        }
      ],
      "precondition_candidates": [
        "x.ndim == 1",
        "y.ndim == 1"
      ],
      "postcondition_candidates": [],
      "witness_shape_semantics": "Reduces two 1D vectors to a scalar float.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "generate_permutation_null",
      "semantic_role": "Shuffle grouped vectors B times without replacement, computing the statistic on each shuffle.",
      "source_targets": [
        "numpy.random.Generator.shuffle"
      ],
      "inputs": [
        {
          "name": "x",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "y",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "metric",
          "type_desc": "str",
          "required": true
        },
        {
          "name": "n_permutations",
          "type_desc": "int",
          "required": true
        },
        {
          "name": "seed",
          "type_desc": "int | None",
          "required": false
        }
      ],
      "outputs": [
        {
          "name": "null_distribution",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "n_permutations > 0"
      ],
      "postcondition_candidates": [
        "len(result) == n_permutations"
      ],
      "witness_shape_semantics": "Produces a 1D array of null stats of size B.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "calculate_permutation_p_value",
      "semantic_role": "Evaluate the proportion of the null distribution exceeding the observed statistic.",
      "source_targets": [
        "scipy.stats.permutation_test"
      ],
      "inputs": [
        {
          "name": "null_distribution",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "observed_stat",
          "type_desc": "float",
          "required": true
        },
        {
          "name": "alternative",
          "type_desc": "str",
          "required": false
        }
      ],
      "outputs": [
        {
          "name": "p_value",
          "type_desc": "float"
        }
      ],
      "precondition_candidates": [
        "alternative in ['two-sided', 'less', 'greater']"
      ],
      "postcondition_candidates": [
        "0.0 <= result <= 1.0"
      ],
      "witness_shape_semantics": "Reduces 1D array to a probability scalar.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    }
  ]
}