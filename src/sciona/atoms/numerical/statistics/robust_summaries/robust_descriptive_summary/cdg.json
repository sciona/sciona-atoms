{
  "cdg_id": "robust_descriptive_summary",
  "name": "robust_descriptive_summary",
  "priority": "medium",
  "decomposition_rationale": "Separates input validation, robust location estimation, robust scale estimation, and summary aggregation to permit isolated unit testing and independent reuse of scale metrics.",
  "family_directory_hint": "src/sciona/atoms/numerical/statistics/robust_summaries/",
  "edges": [
    {
      "source": "validate_and_sort_descriptive_inputs",
      "target": "compute_robust_location",
      "output_name": "sorted_data",
      "input_name": "sorted_data"
    },
    {
      "source": "validate_and_sort_descriptive_inputs",
      "target": "compute_robust_scale",
      "output_name": "sorted_data",
      "input_name": "sorted_data"
    }
  ],
  "cdg_io": {
    "inputs": [
      {
        "name": "data",
        "type_desc": "NDArray[np.float64]",
        "required": true
      },
      {
        "name": "trim_ratio",
        "type_desc": "float",
        "required": false
      }
    ],
    "outputs": [
      {
        "name": "location_metrics",
        "type_desc": "dict[str, float]"
      },
      {
        "name": "scale_metrics",
        "type_desc": "dict[str, float]"
      }
    ]
  },
  "state_model_needed": false,
  "nodes": [
    {
      "name": "validate_and_sort_descriptive_inputs",
      "semantic_role": "Verify array dimensions, finiteness, and sort data in ascending order.",
      "source_targets": [
        "numpy.sort",
        "numpy.isfinite"
      ],
      "inputs": [
        {
          "name": "data",
          "type_desc": "NDArray[np.float64]",
          "required": true,
          "constraints": "1D finite array"
        }
      ],
      "outputs": [
        {
          "name": "sorted_data",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "data.ndim == 1",
        "len(data) >= 3",
        "np.all(np.isfinite(data))"
      ],
      "postcondition_candidates": [
        "len(result) == len(data)",
        "np.all(np.diff(result) >= 0)"
      ],
      "witness_shape_semantics": "Returns a sorted array of the same shape.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "compute_robust_location",
      "semantic_role": "Calculate median, trimmed mean, and Winsorized mean.",
      "source_targets": [
        "scipy.stats.tmean",
        "numpy.median"
      ],
      "inputs": [
        {
          "name": "sorted_data",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "trim_ratio",
          "type_desc": "float",
          "required": false,
          "constraints": "0.0 <= trim_ratio < 0.5"
        }
      ],
      "outputs": [
        {
          "name": "location_metrics",
          "type_desc": "dict[str, float]"
        }
      ],
      "precondition_candidates": [
        "trim_ratio >= 0.0",
        "trim_ratio < 0.5"
      ],
      "postcondition_candidates": [
        "'median' in result",
        "'trimmed_mean' in result"
      ],
      "witness_shape_semantics": "Transforms sorted 1D array to a dictionary of scalar floats.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "compute_robust_scale",
      "semantic_role": "Calculate Interquartile Range (IQR) and Median Absolute Deviation (MAD).",
      "source_targets": [
        "scipy.stats.iqr",
        "scipy.stats.median_abs_deviation"
      ],
      "inputs": [
        {
          "name": "sorted_data",
          "type_desc": "NDArray[np.float64]",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "scale_metrics",
          "type_desc": "dict[str, float]"
        }
      ],
      "precondition_candidates": [],
      "postcondition_candidates": [
        "result['iqr'] >= 0.0",
        "result['mad'] >= 0.0"
      ],
      "witness_shape_semantics": "Transforms sorted 1D array to a dictionary of scale metrics.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    }
  ]
}