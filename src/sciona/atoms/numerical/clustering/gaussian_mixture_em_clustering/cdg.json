          "required": true
        },
        {
          "name": "covariances",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "weights",
          "type_desc": "NDArray[np.float64]",
          "required": true
        }
      ],
      "outputs": [
