          "type_desc": "NDArray[np.float64]"
        },
        {
          "name": "log_likelihood",
          "type_desc": "float"
        }
      ],
      "precondition_candidates": [
        "X.shape[1] == means.shape[1]"
      ],
      "postcondition_candidates": [
        "responsibilities.shape == (X.shape[0], means.shape[0])"
      ],
      "witness_shape_semantics": "Outputs soft probability matrices matching components size.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "gmm_m_step",
      "semantic_role": "Recalculate Gaussian mixture parameters (means, covariances, mixing weights) using responsibilities.",
      "source_targets": [
        "sklearn.mixture.GaussianMixture"
      ],
      "inputs": [
        {
          "name": "X",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "responsibilities",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "covariance_type",
          "type_desc": "str",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "means",
          "type_desc": "NDArray[np.float64]"
        },
        {
          "name": "covariances",
          "type_desc": "NDArray[np.float64]"
        },
        {
          "name": "weights",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "responsibilities.ndim == 2"
      ],
      "postcondition_candidates": [
        "means.shape[0] == responsibilities.shape[1]"
      ],
      "witness_shape_semantics": "Updates model component statistics based on soft assignments.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    }
  ],
