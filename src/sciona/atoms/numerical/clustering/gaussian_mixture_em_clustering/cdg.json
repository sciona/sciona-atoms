{
  "cdg_id": "gaussian_mixture_em_clustering",
  "name": "gaussian_mixture_em_clustering",
  "priority": "medium",
  "decomposition_rationale": "Decompose into E-step (calculating probabilities) and M-step (updating parameters). Decoupling these allows custom covariance types or constraints and clear likelihood monitoring.",
  "family_directory_hint": "src/sciona/atoms/numerical/clustering/",
  "atomic_nodes": [
    {
