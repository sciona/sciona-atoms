{
  "cdg_id": "procrustes_alignment",
  "name": "procrustes_alignment",
  "priority": "medium",
  "decomposition_rationale": "Decompose into centering/normalization, SVD rotation calculation, and transformation projection, enabling partial application (e.g. applying a learned Procrustes rotation to novel vectors).",
  "family_directory_hint": "src/sciona/atoms/numerical/spatial/",
  "edges": [
    {
      "source": "center_and_normalize",
      "target": "compute_optimal_rotation",
      "output_name": "centered",
      "input_name": "standardized_src"
    },
    {
      "source": "center_and_normalize",
      "target": "apply_transform_and_measure",
      "output_name": "centered",
      "input_name": "standardized_src"
    }
  ],
  "cdg_io": {
    "inputs": [
      {
        "name": "data1",
        "type_desc": "NDArray[np.float64]",
        "required": true
      },
      {
        "name": "data2",
        "type_desc": "NDArray[np.float64]",
        "required": true
      }
    ],
    "outputs": [
