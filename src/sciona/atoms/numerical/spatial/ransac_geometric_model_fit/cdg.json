{
  "cdg_id": "ransac_geometric_model_fit",
  "name": "ransac_geometric_model_fit",
  "priority": "medium",
  "decomposition_rationale": "Split model estimation, residual verification, and final refitting. This permits generalizing RANSAC to any geometric target model (lines, circles, homography matrices) by substituting the fitting atom.",
  "family_directory_hint": "src/sciona/atoms/numerical/spatial/",
  "atomic_nodes": [
    {
      "name": "ransac_draw_sample",
      "semantic_role": "Draw a random minimal sample of points, ensuring non-degeneracy.",
      "source_targets": [
        "sklearn.linear_model.RANSACRegressor"
      ],
      "inputs": [
        {
          "name": "X",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "min_samples",
          "type_desc": "int",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "sample_indices",
          "type_desc": "NDArray[np.int64]"
        }
      ],
      "precondition_candidates": [
        "X.ndim == 2",
        "min_samples <= X.shape[0]"
      ],
      "postcondition_candidates": [
        "len(sample_indices) == min_samples"
      ],
      "witness_shape_semantics": "Picks a subset of coordinate records.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "evaluate_consensus",
      "semantic_role": "Compare point residuals against a threshold to construct an inlier mask.",
      "source_targets": [
        "sklearn.linear_model.RANSACRegressor"
      ],
      "inputs": [
        {
          "name": "residuals",
          "type_desc": "NDArray[np.float64]",
          "required": true
        },
        {
          "name": "threshold",
          "type_desc": "float",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "inlier_mask",
          "type_desc": "NDArray[np.bool_]"
        }
      ],
      "precondition_candidates": [
        "threshold > 0.0"
      ],
      "postcondition_candidates": [
        "inlier_mask.shape == residuals.shape"
      ],
      "witness_shape_semantics": "Converts real distances to boolean filters.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    }
  ],
  "edges": [],
  "cdg_io": {
    "inputs": [
      {
