    {
      "name": "solve_perplexity_probabilities",
      "semantic_role": "Use binary search to solve for Gaussian variances matching perplexity targets and yield symmetric joint probabilities.",
      "source_targets": [
        "sklearn.manifold.TSNE"
      ],
      "inputs": [
        {
          "name": "distances",
          "type_desc": "NDArray[np.float64]",
          "required": true
