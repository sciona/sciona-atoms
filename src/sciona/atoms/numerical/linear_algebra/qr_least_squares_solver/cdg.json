          "required": true,
          "constraints": "2D dense matrix"
        },
        {
          "name": "pivoting",
          "type_desc": "bool",
          "required": false,
          "constraints": "Default True"
        }
      ],
      "outputs": [
        {
          "name": "q",
          "type_desc": "NDArray[np.float64 | np.complex128]"
        },
        {
          "name": "r",
          "type_desc": "NDArray[np.float64 | np.complex128]"
        },
        {
          "name": "p",
          "type_desc": "NDArray[np.int32]",
          "required": false
        }
      ],
      "precondition_candidates": [
        "A.ndim == 2"
      ],
      "postcondition_candidates": [
        "q.shape[0] == A.shape[0]",
        "r.shape[1] == A.shape[1]"
      ],
      "witness_shape_semantics": "Computes orthogonal matrix Q and upper triangular R, optional pivot permutation P.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    },
    {
      "name": "qr_solve_least_squares",
      "semantic_role": "Solve least squares using precomputed QR.",
      "source_targets": [
        "scipy.linalg.lstsq"
      ],
      "inputs": [
        {
          "name": "q",
          "type_desc": "NDArray[np.float64 | np.complex128]",
          "required": true
        },
        {
          "name": "r",
          "type_desc": "NDArray[np.float64 | np.complex128]",
          "required": true
        },
        {
          "name": "p",
          "type_desc": "NDArray[np.int32]",
          "required": false
        },
        {
          "name": "b",
          "type_desc": "NDArray[np.float64 | np.complex128]",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "x",
          "type_desc": "NDArray[np.float64 | np.complex128]"
        },
        {
          "name": "residuals",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "b.shape[0] == q.shape[0]"
      ],
      "postcondition_candidates": [
        "x.shape[0] == r.shape[1]"
      ],
      "witness_shape_semantics": "Computes least-squares solution x and sum of squared residuals.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
