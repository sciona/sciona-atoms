{
  "cdg_id": "qr_least_squares_solver",
  "name": "qr_least_squares_solver",
  "priority": "medium",
  "decomposition_rationale": "Separates QR decomposition from least-squares solve to enable reuse of orthogonal basis matrices Q in projection operations.",
  "family_directory_hint": "src/sciona/atoms/numerical/linear_algebra/",
  "atomic_nodes": [
    {
      "name": "qr_factorize",
