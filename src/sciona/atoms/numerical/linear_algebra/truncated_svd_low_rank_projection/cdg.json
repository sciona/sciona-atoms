{
  "cdg_id": "truncated_svd_low_rank_projection",
  "name": "truncated_svd_low_rank_projection",
  "priority": "medium",
  "decomposition_rationale": "Decouples Krylov parameter setting (such as choosing ARPACK vs LOBPCG solver engines) from the vector post-processing phases, allowing structured fallback pipelines.",
  "family_directory_hint": "src/sciona/atoms/numerical/linear_algebra/",
  "atomic_nodes": [
    {
      "name": "compute_truncated_svds",
      "semantic_role": "Solve for top k singular components of a large sparse/dense matrix.",
      "source_targets": [
        "scipy.sparse.linalg.svds"
      ],
      "inputs": [
        {
          "name": "A",
          "type_desc": "NDArray[np.float64] | scipy.sparse.spmatrix",
          "required": true
        },
        {
          "name": "k",
          "type_desc": "int",
          "required": true,
          "constraints": "0 < k < min(A.shape)"
        },
        {
          "name": "solver",
          "type_desc": "str",
          "required": false,
          "constraints": "ARPACK or LOBPCG"
        }
      ],
      "outputs": [
        {
          "name": "U_k",
          "type_desc": "NDArray[np.float64]"
        },
        {
          "name": "s_k",
          "type_desc": "NDArray[np.float64]"
        },
        {
          "name": "Vh_k",
          "type_desc": "NDArray[np.float64]"
        }
      ],
      "precondition_candidates": [
        "k > 0",
        "k < min(A.shape)"
      ],
      "postcondition_candidates": [
        "s_k.shape[0] == k"
      ],
      "witness_shape_semantics": "Returns top k orthogonal projection singular vectors and singular values.",
      "time_complexity": "O(n)",
      "space_complexity": "O(n)",
      "complexity_reasoning": "Linear scan complexity.",
      "complexity_confidence": 90
    }
  ],
  "edges": [],
