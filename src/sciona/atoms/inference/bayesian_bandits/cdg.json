    {
      "node_id": "initialize_beta_beliefs",
      "name": "initialize_beta_beliefs",
      "description": "Creates identical positive Beta prior parameters for each arm",
      "concept_type": "posterior_update",
      "status": "atomic",
      "type_signature": "(n_arms: int, prior_alpha: float = 1.0, prior_beta: float = 1.0) -> tuple[NDArray[np.float64], NDArray[np.float64]]",
      "depth": 1,
      "inputs": [
        {"name": "n_arms", "type_desc": "int", "required": true},
        {"name": "prior_alpha", "type_desc": "float", "required": false},
        {"name": "prior_beta", "type_desc": "float", "required": false}
      ],
      "outputs": [
        {"name": "result", "type_desc": "tuple[NDArray[np.float64], NDArray[np.float64]]"}
      ]
    },
    {
      "node_id": "beta_bernoulli_update",
      "name": "beta_bernoulli_update",
      "description": "Applies the scalar Beta-Bernoulli posterior update after one binary reward",
      "concept_type": "posterior_update",
      "status": "atomic",
      "type_signature": "(alpha: float, beta: float, reward: int) -> tuple[float, float]",
      "depth": 1,
      "inputs": [
        {"name": "alpha", "type_desc": "float", "required": true},
        {"name": "beta", "type_desc": "float", "required": true},
        {"name": "reward", "type_desc": "int", "required": true}
      ],
      "outputs": [
        {"name": "result", "type_desc": "tuple[float, float]"}
      ]
    },
    {
      "node_id": "thompson_sample_beta",
      "name": "thompson_sample_beta",
      "description": "Draws one explicit-RNG Thompson sample from each Beta posterior",
      "concept_type": "sampler",
      "status": "atomic",
      "type_signature": "(alphas: NDArray[np.float64], betas: NDArray[np.float64], rng: np.random.Generator) -> NDArray[np.float64]",
      "depth": 1,
      "inputs": [
        {"name": "alphas", "type_desc": "NDArray[np.float64]", "required": true},
        {"name": "betas", "type_desc": "NDArray[np.float64]", "required": true},
        {"name": "rng", "type_desc": "np.random.Generator", "required": true}
      ],
      "outputs": [
        {"name": "result", "type_desc": "NDArray[np.float64]"}
      ]
    },
    {
